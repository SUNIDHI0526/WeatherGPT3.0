# GEMINI_API_KEY: Required for Gemini AI conversational intelligence, reasoning, tool calling, and alert explanations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEATHER_API_KEY: Optional third-party weather API key (OpenWeatherMap, WeatherAPI, etc.).
# If not provided, WeatherGPT automatically utilizes real-time Open-Meteo WMO high-resolution meteorological APIs for Nagpur District.
WEATHER_API_KEY=""

# IMD_API_KEY: Optional official IMD API key / credentials for direct IMD district feeds.
IMD_API_KEY=""

# GOOGLE_MAPS_API_KEY: Optional Google Maps API key for Maps Directions and advanced routing.
GOOGLE_MAPS_API_KEY=""

# SMS_PROVIDER_API_KEY: Optional SMS gateway credentials (Twilio, Gupshup, Fast2SMS, etc.).
# When not configured, WeatherGPT runs in DEMO SMS MODE with simulated notifications and carrier preview.
SMS_PROVIDER_API_KEY=""
